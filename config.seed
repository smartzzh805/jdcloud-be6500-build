CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq53xx=y
CONFIG_TARGET_DEVICE_qualcommbe_ipq53xx_DEVICE_jdcloud_re-cs-06=y
CONFIG_TARGET_qualcommbe_ipq53xx_DEVICE_jdcloud_re-cs-06=y

# LuCI Web 界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_uhttpd=y

# OpenAppFilter (OAF) 上网行为管理 — 源码来自 destan19/OpenAppFilter
# ImmortalWrt feed 的 open-app-filter 打包的正是该上游源码（commit 569f93bf）
CONFIG_PACKAGE_luci-app-appfilter=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y
